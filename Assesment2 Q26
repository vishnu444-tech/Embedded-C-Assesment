#include <stdio.h>

#define MAX 100

int main(void) {
    int a[MAX], temp[MAX], n, i, k = 0;

    printf("Enter the size of the array (max %d): ", MAX);
    if (scanf("%d", &n) != 1 || n <= 0 || n > MAX) {
        printf("Invalid size.\n");
        return 1;
    }
    printf("Enter %d elements: ", n);
    for (i = 0; i < n; i++)
        if (scanf("%d", &a[i]) != 1) { printf("Invalid input.\n"); return 1; }

    for (i = 0; i < n; i++)            /* pass 1: negatives in original order */
        if (a[i] < 0) temp[k++] = a[i];
    for (i = 0; i < n; i++)            /* pass 2: zero and positives in original order */
        if (a[i] >= 0) temp[k++] = a[i];

    printf("Rearranged array: ");
    for (i = 0; i < n; i++)
        printf("%d ", temp[i]);
    printf("\n");
    return 0;
}
