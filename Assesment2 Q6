#include <stdio.h>

int gcd(int a, int b) {
    if (b == 0)
        return a;
    return gcd(b, a % b);
}

int main(void) {
    int a, b;
    printf("Enter two positive integers: ");
    if (scanf("%d %d", &a, &b) != 2 || a <= 0 || b <= 0) {
        printf("Please enter two positive integers.\n");
        return 1;
    }
    printf("GCD of %d and %d is %d\n", a, b, gcd(a, b));
    return 0;
}
