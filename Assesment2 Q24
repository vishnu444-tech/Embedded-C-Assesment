#include <stdio.h>

#define MAX 100

int main(void) {
    int a[MAX], b[MAX], c[2 * MAX];
    int n1, n2, i = 0, j = 0, k = 0;

    printf("Enter size of first sorted array (max %d): ", MAX);
    if (scanf("%d", &n1) != 1 || n1 < 0 || n1 > MAX) { printf("Invalid size.\n"); return 1; }
    printf("Enter %d elements (ascending): ", n1);
    for (i = 0; i < n1; i++)
        if (scanf("%d", &a[i]) != 1) { printf("Invalid input.\n"); return 1; }

    printf("Enter size of second sorted array (max %d): ", MAX);
    if (scanf("%d", &n2) != 1 || n2 < 0 || n2 > MAX) { printf("Invalid size.\n"); return 1; }
    printf("Enter %d elements (ascending): ", n2);
    for (j = 0; j < n2; j++)
        if (scanf("%d", &b[j]) != 1) { printf("Invalid input.\n"); return 1; }

    i = j = 0;
    while (i < n1 && j < n2) {             /* take the smaller front element */
        if (a[i] <= b[j]) c[k++] = a[i++];
        else              c[k++] = b[j++];
    }
    while (i < n1) c[k++] = a[i++];        /* leftovers from first array */
    while (j < n2) c[k++] = b[j++];        /* leftovers from second array */

    printf("Merged sorted array: ");
    for (i = 0; i < k; i++)
        printf("%d ", c[i]);
    printf("\n");
    return 0;
}
