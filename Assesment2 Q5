#include <stdio.h>
int isPerfect(int num) {
    int i, sum = 0;
    if (num < 2)
        return 0;
    for (i = 1; i <= num / 2; i++) {  
        if (num % i == 0)
            sum += i;
    }
    return sum == num;
}

int main(void) {
    int n;
    printf("Enter a positive integer: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("Please enter a positive integer.\n");
        return 1;
    }
    if (isPerfect(n))
        printf("%d is a perfect number.\n", n);
    else
        printf("%d is not a perfect number.\n", n);
    return 0;
}
