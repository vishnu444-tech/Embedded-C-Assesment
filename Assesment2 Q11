
#include <stdio.h>

int main(void) {
    long long n;
    char str[32], temp[32];
    int i = 0, j = 0, negative = 0;
    unsigned long long u;

    printf("Enter an integer: ");
    if (scanf("%lld", &n) != 1) {
        printf("Invalid input.\n");
        return 1;
    }
    if (n < 0) {
        negative = 1;
        u = -(unsigned long long)n;
    } else {
        u = (unsigned long long)n;
    }
    if (u == 0)
        temp[i++] = '0';
    while (u > 0) {                      
        temp[i++] = (char)('0' + u % 10);
        u /= 10;
    }
    if (negative)
        str[j++] = '-';
    while (i > 0)
        str[j++] = temp[--i];
    str[j] = '\0';

    printf("String: \"%s\"\n", str);
    return 0;
}
