#include <stdio.h>

#define MAX 100

int main(void) {
    int a[MAX], r[MAX], n, k, i;
    char dir;

    printf("Enter the size of the array (max %d): ", MAX);
    if (scanf("%d", &n) != 1 || n <= 0 || n > MAX) {
        printf("Invalid size.\n");
        return 1;
    }
    printf("Enter %d elements: ", n);
    for (i = 0; i < n; i++) {
        if (scanf("%d", &a[i]) != 1) { printf("Invalid input.\n"); return 1; }
    }
    printf("Enter number of positions to rotate: ");
    if (scanf("%d", &k) != 1 || k < 0) {
        printf("Rotation count must be a non-negative integer.\n");
        return 1;
    }
    printf("Enter direction (L for left, R for right): ");
    if (scanf(" %c", &dir) != 1) { printf("Invalid input.\n"); return 1; }

    k %= n;   /* rotating by n (or multiples) changes nothing */
    if (dir == 'L' || dir == 'l') {
        for (i = 0; i < n; i++)
            r[i] = a[(i + k) % n];
    } else if (dir == 'R' || dir == 'r') {
        for (i = 0; i < n; i++)
            r[i] = a[(i - k + n) % n];
    } else {
        printf("Invalid direction. Use L or R.\n");
        return 1;
    }
    printf("Rotated array: ");
    for (i = 0; i < n; i++)
        printf("%d ", r[i]);
    printf("\n");
    return 0;
}
