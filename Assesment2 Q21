#include <stdio.h>

#define MAX 100

int main(void) {
    int a[MAX], n, i, j, k, newSize;

    printf("Enter the size of the array (max %d): ", MAX);
    if (scanf("%d", &n) != 1 || n <= 0 || n > MAX) {
        printf("Invalid size.\n");
        return 1;
    }
    printf("Enter %d elements: ", n);
    for (i = 0; i < n; i++) {
        if (scanf("%d", &a[i]) != 1) { printf("Invalid input.\n"); return 1; }
    }

    newSize = 0;
    for (i = 0; i < n; i++) {
        int duplicate = 0;
        for (j = 0; j < newSize; j++) {      /* already kept this value? */
            if (a[i] == a[j]) { duplicate = 1; break; }
        }
        if (!duplicate)
            a[newSize++] = a[i];
    }
    printf("Array after removing duplicates: ");
    for (k = 0; k < newSize; k++)
        printf("%d ", a[k]);
    printf("\n");
    return 0;
}
