#include <stdio.h>

#define MAX 100

int main(void) {
    int a[MAX], n, target, i, j, found = 0;

    printf("Enter the size of the array (max %d): ", MAX);
    if (scanf("%d", &n) != 1 || n <= 0 || n > MAX) {
        printf("Invalid size.\n");
        return 1;
    }
    printf("Enter %d elements: ", n);
    for (i = 0; i < n; i++)
        if (scanf("%d", &a[i]) != 1) { printf("Invalid input.\n"); return 1; }
    printf("Enter the target sum: ");
    if (scanf("%d", &target) != 1) { printf("Invalid input.\n"); return 1; }

    for (i = 0; i < n - 1; i++) {
        for (j = i + 1; j < n; j++) {      /* j > i: no self-pairing, no repeated pairs */
            if (a[i] + a[j] == target) {
                printf("(%d, %d)\n", a[i], a[j]);
                found = 1;
            }
        }
    }
    if (!found)
        printf("No pairs found with sum %d.\n", target);
    return 0;
}
