#include <stdio.h>
#include <string.h>

int main(void) {
    char s[512];
    int seen[26] = {0}, i, count = 0;

    printf("Enter a string: ");
    if (!fgets(s, sizeof s, stdin)) return 1;

    for (i = 0; s[i] != '\0'; i++) {
        if (s[i] >= 'a' && s[i] <= 'z')
            seen[s[i] - 'a'] = 1;
        else if (s[i] >= 'A' && s[i] <= 'Z')
            seen[s[i] - 'A'] = 1;
    }
    for (i = 0; i < 26; i++)
        count += seen[i];

    if (count == 26)
        printf("The string is a pangram.\n");
    else
        printf("The string is not a pangram (%d of 26 letters present).\n", count);
    return 0;
}
