#include <stdio.h>

double add(double a, double b)      { return a + b; }
double subtract(double a, double b) { return a - b; }
double multiply(double a, double b) { return a * b; }

/* Sets *error = 1 and returns 0 when dividing by zero */
double divide(double a, double b, int *error) {
    if (b == 0.0) {
        printf("Error: division by zero is not allowed.\n");
        *error = 1;
        return 0.0;
    }
    return a / b;
}

/* Selector: calls the right operation based on the operator */
double calculate(double a, double b, char op, int *error) {
    *error = 0;
    switch (op) {
        case '+': return add(a, b);
        case '-': return subtract(a, b);
        case '*': return multiply(a, b);
        case '/': return divide(a, b, error);
        default:
            printf("Error: invalid operator '%c'.\n", op);
            *error = 1;
            return 0.0;
    }
}

int main(void) {
    double a, b, result;
    char op;
    int error;
    printf("Enter first number: ");
    if (scanf("%lf", &a) != 1) { printf("Invalid input.\n"); return 1; }
    printf("Enter operator (+, -, *, /): ");
    if (scanf(" %c", &op) != 1) { printf("Invalid input.\n"); return 1; }
    printf("Enter second number: ");
    if (scanf("%lf", &b) != 1) { printf("Invalid input.\n"); return 1; }

    result = calculate(a, b, op, &error);
    if (!error)
        printf("%.2f %c %.2f = %.2f\n", a, op, b, result);
    return error;
}
