#include <stdio.h>

#define MAX 100

int main(void) {
    int a[MAX], n, i;
    int largest, smallest, secondLargest = 0, secondSmallest = 0;
    int hasSL = 0, hasSS = 0;

    printf("Enter the size of the array (max %d): ", MAX);
    if (scanf("%d", &n) != 1 || n <= 0 || n > MAX) {
        printf("Invalid size.\n");
        return 1;
    }
    printf("Enter %d elements: ", n);
    for (i = 0; i < n; i++) {
        if (scanf("%d", &a[i]) != 1) { printf("Invalid input.\n"); return 1; }
    }

    /* Pass 1: overall largest and smallest */
    largest = smallest = a[0];
    for (i = 1; i < n; i++) {
        if (a[i] > largest)  largest = a[i];
        if (a[i] < smallest) smallest = a[i];
    }
    /* Pass 2: best value strictly below the largest / strictly above the smallest */
    for (i = 0; i < n; i++) {
        if (a[i] < largest && (!hasSL || a[i] > secondLargest)) {
            secondLargest = a[i];
            hasSL = 1;
        }
        if (a[i] > smallest && (!hasSS || a[i] < secondSmallest)) {
            secondSmallest = a[i];
            hasSS = 1;
        }
    }

    if (!hasSL || !hasSS) {
        printf("All elements are the same, so there is no second largest or second smallest.\n");
    } else {
        printf("Second largest  = %d\n", secondLargest);
        printf("Second smallest = %d\n", secondSmallest);
    }
    return 0;
}
