#include <stdio.h>

int main() {
    int n, i;
    unsigned long long a = 0, b = 1, next;
    printf("Enter the number of terms: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("Please enter a positive number of terms.\n");
        return 1;
    }
    printf("Fibonacci series: ");
    for (i = 0; i < n; i++) {
        printf("%llu ", a);
        next = a + b;
        a = b;
        b = next;
    }
    printf("\n");
    return 0;
}
