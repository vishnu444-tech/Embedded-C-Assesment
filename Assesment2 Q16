#include <stdio.h>
#include <string.h>

int main(void) {
    char s[512];
    int i;

    printf("Enter a string: ");
    if (!fgets(s, sizeof s, stdin)) return 1;
    s[strcspn(s, "\n")] = '\0';

    for (i = 0; s[i] != '\0'; i++) {
        if (s[i] >= 'A' && s[i] <= 'Z')
            s[i] = s[i] + ('a' - 'A');   /* difference is 32 in ASCII */
    }
    printf("Lowercase string: %s\n", s);
    return 0;
}
