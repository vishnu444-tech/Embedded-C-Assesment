#include <stdio.h>
#include <string.h>

int main(void) {
    char s[256], tmp;
    int i, j;

    printf("Enter a string: ");
    if (!fgets(s, sizeof s, stdin)) return 1;
    s[strcspn(s, "\n")] = '\0';

    for (i = 0, j = (int)strlen(s) - 1; i < j; i++, j--) {
        tmp = s[i];
        s[i] = s[j];
        s[j] = tmp;
    }
    printf("Reversed string: %s\n", s);
    return 0;
}
