#include <stdio.h>
void countDigits(long long n, int freq[]) {
    int i;
    unsigned long long u = (n < 0) ? -(unsigned long long)n : (unsigned long long)n;
    for (i = 0; i < 10; i++)
        freq[i] = 0;
    if (u == 0) {
        freq[0] = 1;
        return;
    }
    while (u > 0) {
        freq[u % 10]++;
        u /= 10;
    }
}

int main(void) {
    long long n;
    int freq[10], i;
    printf("Enter an integer: ");
    if (scanf("%lld", &n) != 1) {
        printf("Invalid input.\n");
        return 1;
    }
    countDigits(n, freq); 
    for (i = 0; i < 10; i++) {
        if (freq[i] > 0)
            printf("Digit %d appears %d time(s)\n", i, freq[i]);
    }
    return 0;
}
