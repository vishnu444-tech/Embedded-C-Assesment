#include <stdio.h>
#include <string.h>

int main(void) {
    char s[64];
    int i = 0, sign = 1;
    long long value = 0;

    printf("Enter a number as a string: ");
    if (scanf("%63s", s) != 1) {
        printf("Invalid input.\n");
        return 1;
    }
    if (s[0] == '-') { sign = -1; i = 1; }
    else if (s[0] == '+') { i = 1; }

    if (s[i] == '\0' || strlen(s) - i > 18) {
        printf("Invalid or too long (max 18 digits).\n");
        return 1;
    }
    for (; s[i] != '\0'; i++) {
        if (s[i] < '0' || s[i] > '9') {
            printf("Invalid character '%c' in input.\n", s[i]);
            return 1;
        }
        value = value * 10 + (s[i] - '0');   /* shift left one decimal place, add digit */
    }
    value *= sign;
    printf("Integer value: %lld\n", value);
    printf("Value + 1 = %lld (proves it is a real integer)\n", value + 1);
    return 0;
}
